---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import WorkGrid from '../components/WorkGrid.astro';
import HeroTectonic from '../components/HeroTectonic.astro';
import { getWorks } from '../lib/works';

const works = (await getWorks()).filter((w) => w.data.kind === 'work').slice(0, 6);
const mooring = await getEntry('works', 'bamboo-mooring');
if (!mooring) throw new Error('首頁主視覺需要作品 bamboo-mooring');
---
<Base lang="zh" description="初樸建築師事務所，臺中豐原。竹、木、土自然材料的當代構築。">
  <!-- 首頁主視覺試作：方向四｜構築拆解（原樣板 Tectonic） -->
  <HeroTectonic work={mooring} />
  <section>
    <div class="section-head">
      <h2>近期作品</h2>
      <a href="/works/">全部作品</a>
    </div>
    <WorkGrid works={works} lang="zh" />
  </section>
</Base>
