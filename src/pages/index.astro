---
import Base from '../layouts/Base.astro';
import AxisColumns from '../components/AxisColumns.astro';
import DotField from '../components/DotField.astro';
import { getWorks } from '../lib/works';

const works = await getWorks();
---
<Base lang="zh" description="初樸建築師事務所，臺中豐原。竹、木、土自然材料的當代構築。">
  <!-- 首頁 C 案試作｜雙軸延續：兩欄各自輪播，下接作品清單；最下方為歷年專案微塵 -->
  <section class="home-intro" data-reveal>
    <h1>竹、木、土自然材料的當代構築</h1>
    <p>形體之外的光與氣，建築之外的時間與生命。</p>
  </section>
  <AxisColumns works={works} />
  <div class="home-dots" data-reveal>
    <DotField />
  </div>
</Base>
