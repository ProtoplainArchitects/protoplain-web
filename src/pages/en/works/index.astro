---
import Base from '../../../layouts/Base.astro';
import WorkTimeline from '../../../components/WorkTimeline.astro';
import WorkGrid from '../../../components/WorkGrid.astro';
import { getWorks, getEnglishIds } from '../../../lib/works';

const enIds = await getEnglishIds();
const all = await getWorks();
const works = all.filter((w) => enIds.has(w.id));
---
<Base lang="en" title="Works" altHref="/works/">
  <h1 class="page-title">Works</h1>
  <!-- 時間軸放全部作品；沒有英文頁的作品連到中文頁 -->
  <WorkTimeline works={all} lang="en" enIds={enIds} />
  <WorkGrid works={works} lang="en" enIds={enIds} filter />
</Base>
