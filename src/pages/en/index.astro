---
import Base from '../../layouts/Base.astro';
import HomeStage from '../../components/HomeStage.astro';
import AwardsFeature from '../../components/AwardsFeature.astro';
import { getWorks, getEnglishIds } from '../../lib/works';

const works = await getWorks();
const enIds = await getEnglishIds();
---
<Base lang="en" altHref="/" description="ProtoPlain Architects, Taichung. Contemporary tectonics of bamboo, timber and earth.">
  <h1 class="visually-hidden">ProtoPlain Architects</h1>
  <HomeStage works={works} lang="en" enIds={enIds} />
  <section class="home-intro" aria-label="About ProtoPlain">
    <p data-reveal>Bamboo, timber, earth:<br />contemporary tectonics of natural materials.</p>
    <p data-reveal>Beyond form, light and air;<br />beyond the building, time and life.</p>
    <p class="home-more" data-reveal><a href="/en/works/">All works →</a></p>
  </section>
  <AwardsFeature lang="en" />
</Base>
