---
import Base from '../../layouts/Base.astro';
import WorkTimeline from '../../components/WorkTimeline.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import DotField from '../../components/DotField.astro';
import { getWorks } from '../../lib/works';

const works = await getWorks();
---
<Base lang="zh" title="作品" altHref="/en/works/">
  <!-- 作品頁｜上：人文與自然共用的時間軸；中：全部作品與篩選；下：歷年專案微塵 -->
  <h1 class="page-title">作品</h1>
  <WorkTimeline works={works} lang="zh" />
  <WorkGrid works={works} lang="zh" filter />
  <div class="works-dots" data-reveal>
    <DotField />
  </div>
</Base>
