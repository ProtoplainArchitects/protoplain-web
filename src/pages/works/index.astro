---
import Base from '../../layouts/Base.astro';
import WorkParticles from '../../components/WorkParticles.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import DotField from '../../components/DotField.astro';
import { getWorks } from '../../lib/works';

const works = await getWorks();
---
<Base lang="zh" title="作品" altHref="/en/works/">
  <!-- 作品頁｜上：全部作品與篩選；下：作品分布（時間／地點，微塵）與歷年專案微塵 -->
  <h1 class="page-title">作品</h1>
  <WorkGrid works={works} lang="zh" filter />
  <WorkParticles works={works} lang="zh" />
  <div class="works-dots" data-reveal>
    <DotField />
  </div>
</Base>
