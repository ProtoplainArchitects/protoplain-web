---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkDetail from '../../components/WorkDetail.astro';
import { builds } from '../../data/builds';
import { getWorks, getEnglishIds, workUrl } from '../../lib/works';

export async function getStaticPaths() {
  const [works, enIds] = await Promise.all([getWorks(), getEnglishIds()]);
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: { work, hasEn: enIds.has(work.id), next: works[(i + 1) % works.length] },
  }));
}
const { work, hasEn, next } = Astro.props;
const { Content } = await render(work);
---
<Base lang="zh" title={work.data.title} description={work.data.subtitle ?? undefined} altHref={hasEn ? workUrl(work.id, 'en') : '/en/works/'}>
  <WorkDetail
    work={work} lang="zh" title={work.data.title} subtitle={work.data.subtitle} body={work.body}
    build={builds[work.id]} next={{ href: workUrl(next.id, 'zh'), title: next.data.title }}
  >
    <Content />
  </WorkDetail>
</Base>
