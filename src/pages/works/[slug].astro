---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkDetail from '../../components/WorkDetail.astro';
import TectonicViewer from '../../components/TectonicViewer.astro';
import ManualReader from '../../components/ManualReader.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import { builds } from '../../data/builds';
import { getWorks, getEnglishIds, workUrl } from '../../lib/works';

export async function getStaticPaths() {
  const [works, enIds] = await Promise.all([getWorks(), getEnglishIds()]);
  return works.map((work) => ({ params: { slug: work.id }, props: { work, hasEn: enIds.has(work.id) } }));
}
const { work, hasEn } = Astro.props;
const { Content } = await render(work);
const build = builds[work.id];
---
<Base lang="zh" title={work.data.title} description={work.data.subtitle ?? undefined} altHref={hasEn ? workUrl(work.id, 'en') : '/en/works/'}>
  <WorkDetail work={work} lang="zh" title={work.data.title} subtitle={work.data.subtitle}>
    <Content />
    {build && (
      <Fragment slot="extra">
        <TectonicViewer build={build} title={work.data.title} />
        <ManualReader build={build} title={work.data.title} />
        <PhotoGallery build={build} title={work.data.title} />
        <Lightbox />
      </Fragment>
    )}
  </WorkDetail>
</Base>
