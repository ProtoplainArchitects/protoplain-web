---
import '../styles/pp-tokens.css';
import '../styles/site.css';
import logo from '../assets/pp-logo-calligraphy.png';

interface Props {
  title?: string;
  description?: string;
  lang: 'zh' | 'en';
  /** 對應另一語言版本的路徑；沒有就連到該語言首頁 */
  altHref?: string;
}
const { title, description, lang, altHref } = Astro.props;
const siteName = lang === 'en' ? 'ProtoPlain Architects' : '初樸建築師事務所';
const fullTitle = title ? `${title}｜${siteName}` : siteName;
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const home = lang === 'en' ? '/en/' : '/';
const nav = lang === 'en'
  ? [
      { href: '/en/works/', label: 'Works' },
      { href: '/en/awards/', label: 'Awards' },
      { href: '/en/members/', label: 'Members' },
      { href: '/en/contact/', label: 'Contact' },
    ]
  : [
      { href: '/works/', label: '作品' },
      { href: '/awards/', label: '獲獎' },
      { href: '/members/', label: '成員' },
      { href: '/contact/', label: '聯繫' },
    ];
const alt = lang === 'en'
  ? { href: altHref ?? '/', label: '中文' }
  : { href: altHref ?? '/en/', label: 'EN' };
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-Hant-TW'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+TC:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={home}>
        <span class="brand-logo" role="img" aria-label="初樸建築師事務所" style={`--logo: url(${logo.src})`}></span>
        <span class="brand-en">ProtoPlain Architects</span>
      </a>
      <nav aria-label={lang === 'en' ? 'Main' : '主要導覽'}>
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="lang" href={alt.href} hreflang={lang === 'en' ? 'zh-Hant' : 'en'}>{alt.label}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {lang === 'en' ? 'ProtoPlain Architects' : '初樸建築師事務所'}</span>
      <span>{lang === 'en' ? 'Taichung, Taiwan' : '臺中・豐原'}</span>
    </footer>
    <script>
      // 有 data-reveal 的區塊第一次進入畫面時浮現；沒有 JS 時維持原樣直接顯示
      document.documentElement.classList.add('js');
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          // 同一批進畫面的列依序錯開一點，最多 0.3 秒
          el.style.transitionDelay = `${Math.min(Number(el.dataset.i ?? 0) * 40, 300)}ms`;
          el.classList.add('is-in');
          io.unobserve(el);
        }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      let batch = 0;
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        const r = el.getBoundingClientRect();
        el.dataset.i = String(r.top < innerHeight ? batch++ : 0);
        io.observe(el);
      });
    </script>
  </body>
</html>
