---
// 作品頁。順序：封面 → 短文 → 完工 → 過程 → 構築 → 情境 → 資料 → 下一件；沒有資料的段落不出現。頁面上不放編號與張數。
// 內文（slot）最後一張清單視為作品資料，移到頁尾的「資料」段。
import { Image, getImage } from 'astro:assets';
import ConstructionVideo from './ConstructionVideo.astro';
import TectonicViewer from './TectonicViewer.astro';
import ManualReader from './ManualReader.astro';
import Lightbox from './Lightbox.astro';
import PhotoStrip from './PhotoStrip.astro';
import type { Build } from '../data/builds';
import { axisLabel, kindLabel, type Lang, type Work } from '../lib/works';

interface Props {
  work: Work;
  lang: Lang;
  title: string;
  subtitle: string | null;
  /** 內文的 Markdown 原文，用來判斷結尾有沒有資料清單 */
  body?: string;
  /** 影片、模型、說明書、照片；目前只有中文頁會傳 */
  build?: Build;
  next?: { href: string; title: string };
}
const { work, lang, title, subtitle, body = '', build, next } = Astro.props;
const d = work.data;
const t = (zh: string, en: string) => (lang === 'en' ? en : zh);
const html = await Astro.slots.render('default');
const hasFacts = /^[-*] /.test(body.trimEnd().split('\n').pop() ?? '');

const PROCESS = '施工過程';
const all = await Promise.all(
  (build?.gallery ?? []).map(async (g) => ({
    ...g,
    full: (await getImage({ src: g.src, width: 1800, format: 'webp' })).src,
    label: g.kind === 'render' ? `情境模擬：${g.caption}` : g.caption,
  })),
);
const process = all.filter((g) => g.kind === 'photo' && g.group === PROCESS);
const renders = all.filter((g) => g.kind === 'render');
// 完工以外的分組（例如細部）在說明前面標出組名
const done = all
  .filter((g) => g.kind === 'photo' && g.group !== PROCESS)
  .map((g) => ({ ...g, tag: g.group === '完工' ? undefined : g.group }));

const hasProcess = process.length > 0 || !!build?.video;
// 完工照的第一張就是封面：封面直接用它（比 cover.jpg 的裁切版完整），點開進放大檢視；橫卷從第二張開始
const hero = done[0];
const rest = done.slice(1);

// 頁面上不出現編號與張數。level 是索引上那條橫線的長短（1 短、2 中、3 長），只暗示內容多寡；只有影片的過程段用播放記號
const level = (n: number) => (n >= 10 ? 3 : n >= 5 ? 2 : n >= 2 ? 1 : 0);
const sections = [
  rest.length > 0 && { id: 'done', zh: '完工', en: 'Completed', level: level(done.length), play: false },
  hasProcess && { id: 'process', zh: '過程', en: 'Process', level: level(process.length), play: process.length === 0 },
  build && { id: 'tectonic', zh: '構築', en: 'Tectonics', level: level(build.steps.length), play: false },
  renders.length > 0 && { id: 'scene', zh: '情境', en: 'Scenarios', level: level(renders.length), play: false },
  hasFacts && { id: 'facts', zh: '資料', en: 'Facts', level: 0, play: false },
].filter(Boolean) as { id: string; zh: string; en: string; level: number; play: boolean }[];
// 只有一段時不出現段落索引
const multi = sections.length > 1;
const label = (id: string) => { const x = sections.find((y) => y.id === id)!; return t(x.zh, x.en); };
---
<article class="work">
  <header class="work-head">
    <p class="pp-caption">
      {kindLabel[d.kind][lang]}{d.axis && <> ・ {axisLabel[d.axis][lang]}</>}
    </p>
    <h1>{title}</h1>
    <p class="work-sub">
      <span>{subtitle}</span>
      <span class="work-where"><span class="pp-data">{d.year}</span>{lang === 'zh' && d.location && <> ・ {d.location}</>}</span>
    </p>
    {d.draft && <p class="draft-flag">draft：{d.review.join('、')}（不會出現在正式網站）</p>}
  </header>

  {hero ? (
    <figure class="work-cover">
      <a href={hero.full} data-lb="done" data-caption={hero.label} aria-label={t('放大檢視完工照片', 'View photos')}>
        <Image src={hero.src} alt={title} widths={[800, 1260, 1800, 2500].filter((w) => w < hero.src.width).concat(hero.src.width)} sizes="100vw" format="webp" loading="eager" />
      </a>
    </figure>
  ) : d.cover && (
    <figure class="work-cover">
      {/* 封面一律撐滿版寬，視覺強度優先；原圖不足 2500px 的待換高解析原檔 */}
      <Image src={d.cover} alt={title} widths={[800, 1260, 1800, 2500].filter((w) => w < d.cover!.width).concat(d.cover!.width)} sizes="100vw" format="webp" loading="eager" />
      {/* 封面不是實景照片時要標明，避免被當成完工照 */}
      {d.coverKind === 'render' && <figcaption class="work-cover-tag">{t('情境模擬', 'Rendering')}</figcaption>}
    </figure>
  )}

  {multi && (
    <nav class="work-nav" aria-label={t('本頁段落', 'On this page')}>
      {sections.map((s) => (
        <a href={`#${s.id}`} data-sec={s.id}>
          {t(s.zh, s.en)}
          {s.play && <span class="work-nav-play" aria-hidden="true"></span>}
          {s.level > 0 && <span class:list={['work-nav-line', `l${s.level}`]} aria-hidden="true"></span>}
        </a>
      ))}
    </nav>
  )}

  <div class:list={['work-text', hasFacts && 'has-facts']} data-reveal set:html={html} />

  {rest.length > 0 && (
    <section class="work-sec" id="done">
      <div class="work-sec-head" data-reveal>
        <h2>{label('done')}</h2>
      </div>
      <PhotoStrip items={rest} title={title} group="done" size="l" />
    </section>
  )}

  {hasProcess && (
    <section class="work-sec" id="process">
      <div class="work-sec-head" data-reveal>
        <h2>{label('process')}</h2>
      </div>
      {process.length > 0 && (
        <>
          <p class="work-lead" data-reveal>依施工先後由左到右。</p>
          <PhotoStrip items={process} title={`${title}施工過程`} group="process" size="s" />
        </>
      )}
      {build?.video && <div class:list={[process.length > 0 && 'work-gap']}><ConstructionVideo video={build.video} /></div>}
    </section>
  )}

  {build && (
    <section class="work-sec" id="tectonic">
      <div class="work-sec-head" data-reveal>
        <h2>{label('tectonic')}</h2>
      </div>
      <TectonicViewer build={build} title={title} />
      {build.manual && (
        <>
          <h3 class="work-h3">組裝說明書 <span class="pp-data">{build.manual.version}</span></h3>
          <ManualReader manual={build.manual} steps={build.steps} title={title} />
        </>
      )}
    </section>
  )}

  {renders.length > 0 && (
    <section class="work-sec" id="scene">
      <div class="work-sec-head" data-reveal>
        <h2>{label('scene')}</h2>
      </div>
      <p class="work-lead" data-reveal>情境模擬圖以模型為基礎合成，人物與場景不是實景照片，也不代表完工後的實際使用情形。</p>
      <PhotoStrip items={renders} title={`${title}情境模擬`} group="scene" size="s" />
    </section>
  )}

  {hasFacts && (
    <section class="work-sec" id="facts">
      <div class="work-sec-head" data-reveal>
        <h2>{label('facts')}</h2>
      </div>
      <div class="work-facts" data-reveal set:html={html} />
    </section>
  )}

  {/* 頁尾導覽收在一列：左邊回列表，右邊下一件，都用小字 */}
  <nav class="work-end" aria-label={t('作品導覽', 'More works')}>
    <a href={lang === 'en' ? '/en/works/' : '/works/'}>{t('← 作品列表', '← All works')}</a>
    {next && (
      <a class="work-next" href={next.href}>
        <span class="work-next-label">{t('下一件', 'Next')}</span>
        {next.title}
        <span class="work-next-arrow" aria-hidden="true">→</span>
      </a>
    )}
  </nav>

  {build && <Lightbox />}
</article>

<script>
    // 段落索引：標出目前所在段落
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.work-nav a'));
    const secs = links.map((a) => document.getElementById(a.dataset.sec!)!);
    const mark = () => {
      let cur = -1;
      secs.forEach((s, i) => { if (s.getBoundingClientRect().top < innerHeight * 0.4) cur = i; });
      links.forEach((a, i) => a.setAttribute('aria-current', String(i === cur)));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
</script>
