---
import { Image } from 'astro:assets';
import { members, affiliates } from '../data/members';
import type { Lang } from '../lib/works';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
// 全員同一格大小：主持與所務排在最前面，其餘依原順序
const people = [...members.filter((m) => m.lead), ...members.filter((m) => !m.lead)];
// 主名依頁面語言，副名用另一語言，兩頁都看得到中英對照
const names = (m: (typeof members)[number]) => (en ? [m.en, m.zh] : [m.zh, m.en]);
---
<ul class="team">
  {people.map((m, i) => (
    <li class="member" data-reveal>
      <div class="photo">
        <Image src={m.photo} alt={names(m)[0]} widths={[320, 640]} sizes="(max-width: 640px) 50vw, (max-width: 1100px) 25vw, 180px" format="webp" loading={i < 7 ? 'eager' : 'lazy'} />
      </div>
      <h2 class="name">{names(m)[0]}<span class="name-alt">{names(m)[1]}</span></h2>
      <p class="role">{en ? m.roleEn : m.roleZh}</p>
      {(en ? m.bioEn : m.bioZh).length > 0 && (
        <ul class="bio">
          {(en ? m.bioEn : m.bioZh).map((b) => <li>{b}</li>)}
        </ul>
      )}
    </li>
  ))}
</ul>

<p class="pp-data scope">{en ? 'Arch. | Tectonic | Urban' : '建築｜自然構築｜豐原計畫'}</p>
<div class="affiliates">
  {affiliates.map((a) => (
    <section class="affiliate">
      <h2>{en ? a.en : a.zh}</h2>
      {(en ? a.bodyEn : a.bodyZh).map((p) => <p>{p}</p>)}
      {a.link && <a class="ext" href={a.link.href} rel="noopener">{a.link.label}</a>}
    </section>
  ))}
</div>

<style>
  /* 照片統一 4:5，裁切已在原檔完成；容器再鎖一次比例，避免版面跳動 */
  .photo { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--pp-radius-control); background: var(--pp-bg-card-sub); margin-bottom: var(--pp-space-xs); }
  .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* 14 人：寬螢幕 7 欄兩列剛好排滿；中寬 4 欄；手機 2 欄 */
  .team {
    list-style: none; margin: 0 0 calc(var(--pp-space-xl) * 1.5); padding: 0;
    display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--pp-space-xl) var(--pp-space-sm);
  }
  .member { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-size: var(--pp-fs-body); font-weight: var(--pp-fw-medium); margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--pp-space-xs); }
  .name-alt { font-size: var(--pp-fs-caption); font-weight: var(--pp-fw-regular); color: var(--pp-ink-hint); }
  .role { font-size: var(--pp-fs-caption); color: var(--pp-ink-sub); margin: 0; }
  .bio {
    list-style: none; margin: var(--pp-space-xs) 0 0; padding: var(--pp-space-xs) 0 0;
    border-top: var(--pp-border-width) solid var(--pp-line);
    font-size: var(--pp-fs-caption); color: var(--pp-ink-hint); line-height: 1.6;
  }

  @media (max-width: 1100px) {
    .team { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--pp-space-lg) var(--pp-space-md); }
  }
  @media (max-width: 640px) {
    .team { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--pp-space-lg) var(--pp-space-sm); }
  }

  .scope { color: var(--pp-ink-sub); letter-spacing: 0.08em; margin-bottom: var(--pp-space-md); }
  .affiliates { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--pp-space-lg); }
  .affiliate { border-top: var(--pp-border-width) solid var(--pp-line); padding-top: var(--pp-space-md); }
  .affiliate h2 { font-size: var(--pp-fs-h3); }
  .affiliate p { color: var(--pp-ink-sub); }
  .ext { font-size: var(--pp-fs-caption); color: var(--pp-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
