---
// 歷年專案微塵：pp-archive 統計頁的公開版，只取頭尾兩段。
// 先由微塵聚成照片（每個深色點是一件專案，重量愈高點愈大、落在照片愈暗的位置；淡色點是補滿影像的背景），
// 再散回空氣，停在最後一段：背景點上升淡去，專案微塵各自漂浮，偶爾有一道光掃過。
// 資料由 scripts/export_dots.py 產生，只含座標、重量、年份與網站作品 slug。
import dots from '../data/dots.json';
import { getWorks, workUrl } from '../lib/works';

// 只有正式建置裡存在的作品才可點；其餘點匿名，只顯示年份
const published = new Map(
  (await getWorks()).filter((w) => !w.data.draft).map((w) => [w.id, { t: w.data.title, h: workUrl(w.id, 'zh') }]),
);
const data = {
  aspect: dots.aspect,
  air: dots.air,
  dots: dots.dots.map((d) => ({ ...d, s: d.s && published.has(d.s) ? d.s : null })),
  works: Object.fromEntries(published),
};
const linked = [...new Set(data.dots.map((d) => d.s).filter((s): s is string => !!s))].map((s) => ({ s, ...published.get(s)! }));
const years = data.dots.map((d) => d.y).filter((y): y is number => !!y);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---
<section class="dots" aria-labelledby="dots-title">
  <div class="section-head">
    <h2 id="dots-title">歷年專案</h2>
    <span class="dots-meta"><span class="pp-data dots-span">{span}</span><button type="button" class="dots-replay">重播</button></span>
  </div>
  <div class="dots-stage" style={`aspect-ratio: ${data.aspect}`}>
    <canvas class="dots-canvas" role="img" aria-label={`事務所 ${span} 年間歷年專案的點狀圖，每一點是一件專案`}></canvas>
    <div class="dots-tip" hidden></div>
  </div>
  <p class="dots-note">每一點是一件專案，重量愈高點愈大、愈濃。滑過看年份，已上站的作品可點進作品頁。</p>
  <ul class="dots-links" aria-label="圖中可點的作品">
    {linked.map((w) => <li><a href={w.h}>{w.t}</a></li>)}
  </ul>
  <script type="application/json" class="dots-data" set:html={JSON.stringify(data)}></script>
</section>

<style>
  .dots { padding-bottom: var(--pp-space-xl); }
  .dots-meta { display: flex; align-items: baseline; gap: var(--pp-space-sm); }
  .dots-span { color: var(--pp-ink-sub); }
  .dots-replay { font: inherit; font-size: var(--pp-fs-caption); color: var(--pp-ink-sub); background: none; border: 0; padding: 0; cursor: pointer; }
  .dots-replay:hover { color: var(--pp-ink); }
  .dots-stage { position: relative; width: 100%; border-top: var(--pp-border-width) solid var(--pp-ink); }
  .dots-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dots-tip {
    position: absolute; pointer-events: none; white-space: nowrap;
    background: var(--pp-bg-card); border: var(--pp-border-width) solid var(--pp-line-strong);
    border-radius: var(--pp-radius-control); padding: 6px 10px;
    font-size: var(--pp-fs-caption); line-height: 1.4;
  }
  .dots-note { font-size: var(--pp-fs-caption); color: var(--pp-ink-sub); margin: var(--pp-space-sm) 0 var(--pp-space-xs); }
  .dots-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px var(--pp-space-sm); font-size: var(--pp-fs-caption); }
  .dots-links a { color: var(--pp-ink-sub); }
  .dots-links a:hover { color: var(--pp-ink); }
</style>

<script>
  type Dot = { u: number; v: number; t: number; w: number; y: number | null; s: string | null };
  type Data = { aspect: number; air: [number, number, number][]; dots: Dot[]; works: Record<string, { t: string; h: string }> };

  // 時間軸（秒）：0.2–2.6 聚成照片，停留到 5.6，之後散回空氣並停在這一段
  const FORM = 2.4, HOLD = 5.6, LIGHT_EVERY = 14, LIGHT_DUR = 7.5, LIGHT_BAND = 90;

  function init(root: HTMLElement) {
    const data: Data = JSON.parse(root.querySelector('.dots-data')!.textContent!);
    const cv = root.querySelector<HTMLCanvasElement>('.dots-canvas')!;
    const tip = root.querySelector<HTMLElement>('.dots-tip')!;
    const ctx = cv.getContext('2d');
    if (!ctx) return;

    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--pp-ink').trim();
    const hint = css.getPropertyValue('--pp-ink-hint').trim();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 固定種子的亂數，每次載入落點一樣
    const rnd = (i: number) => ((Math.sin(i * 12.9898) * 43758.5453) % 1 + 1) % 1;
    const air = data.air.map((a, i) => ({ u: a[0], v: a[1], t: a[2], p: rnd(i) * 6.28, su: rnd(i + 7), sv: rnd(i + 13), x: 0, y: 0, a: 1 }));
    const keys = data.dots.map((d, i) => ({
      ...d, p: rnd(i + 3000) * 6.28, su: rnd(i + 3007), sv: rnd(i + 3013), z: rnd(i + 3021), delay: rnd(i + 3031) * 1.2,
      x: 0, y: 0, rr: 0, sx: 0, sy: 0,
    }));

    let W = 0, H = 0, dpr = 1, airR = 1.4;
    const resize = () => {
      const r = cv.getBoundingClientRect();
      dpr = Math.min(2, window.devicePixelRatio || 1);
      W = r.width; H = r.height;
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      airR = Math.max(0.9, Math.min(1.8, W / 700));
    };
    new ResizeObserver(resize).observe(cv);
    resize();

    const scale = () => Math.max(0.6, Math.min(1, W / 1000));
    const rPhoto = (w: number) => (1.4 + 3.2 * w) * scale();
    const rAir = (d: (typeof keys)[number]) => (1.2 + 2.4 * d.w) * (0.55 + 0.9 * d.z) * scale();
    // 照片上的位置；enter：0＝散開，1＝在照片位置
    const photoPos = (d: { u: number; v: number; p: number; su: number; sv: number }, t: number, enter: number) => {
      const x = d.u * W + Math.sin(t * 0.4 + d.p) * 1.2;
      const y = d.v * H + Math.cos(t * 0.33 + d.p) * 1.2;
      return [x + (d.su * W - x) * (1 - enter), y + (d.sv * H - y) * (1 - enter)];
    };
    // 空氣的流場：緩慢、略往上
    const flow = (x: number, y: number, t: number, z: number, seed: number) => {
      const s = 4.2 * (0.45 + z);
      return [(0.6 * Math.sin(y * 0.016 + t * 0.09) + 0.5 * Math.sin(x * 0.011 - t * 0.05) + 0.7 * Math.sin(t * 0.43 + seed)) * s,
              (0.5 * Math.cos(x * 0.014 + t * 0.07) + 0.4 * Math.sin(y * 0.012 + t * 0.04) + 0.6 * Math.cos(t * 0.37 + seed * 1.3) - 0.35) * s];
    };
    let lightAt = -1e9;
    const lightBoost = (x: number, y: number, t: number) => {
      const u = (t - lightAt) / LIGHT_DUR;
      if (reduce || u < 0 || u > 1) return 0;
      const ca = Math.cos(0.384), sa = Math.sin(0.384);
      const e = u * u * (3 - 2 * u), sweep = -LIGHT_BAND + (W * ca + H * sa + 2 * LIGHT_BAND) * e;
      const dd = (x * ca + y * sa - sweep) / LIGHT_BAND;
      return Math.exp(-dd * dd);
    };

    let t0 = performance.now(), last = t0, released = false, relT = 0;
    let hover: (typeof keys)[number] | null = null;
    const start = () => {
      t0 = last = performance.now(); released = false; lightAt = -1e9;
      air.forEach((a) => { a.a = 1; });
      keys.forEach((d) => { d.rr = 0; });
    };

    // 減少動態：直接停在空氣這一段，靜止
    const settle = () => {
      released = true;
      air.forEach((a) => { a.a = 0; });
      keys.forEach((d) => { d.x = d.su * W; d.y = d.sv * H; d.rr = rAir(d); });
    };

    const draw = (now: number) => {
      const t = (now - t0) / 1000, dt = Math.min(0.05, (now - last) / 1000 || 0.016);
      last = now;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      const enter = reduce ? 1 : Math.min(1, Math.max(0, (t - 0.2) / FORM));
      const e = 1 - Math.pow(1 - enter, 3);

      if (!released && !reduce && t >= HOLD) {
        released = true; relT = t;
        keys.forEach((d) => { [d.x, d.y] = photoPos(d, t, 1); d.sx = d.x; d.sy = d.y; });
        air.forEach((a) => { [a.x, a.y] = photoPos(a, t, 1); });
        lightAt = t + 3.2;
      }
      if (released && !reduce && t - lightAt > LIGHT_EVERY) lightAt = t;

      // 背景點：成像時疊出照片明暗；散開後往上飄並淡去
      ctx.fillStyle = hint;
      // 背景點約 3 秒淡完；依經過時間計算，不受畫面更新頻率影響
      const fade = released && !reduce ? Math.exp(-(t - relT) / 0.9) : 1;
      for (const a of air) {
        if (released) {
          if (a.a * fade < 0.015) continue;
          if (!reduce) {
            const [vx, vy] = flow(a.x, a.y, t, 0.5, a.p * 100);
            a.x += vx * dt * 1.6; a.y += (vy - 6) * dt;
          }
        } else [a.x, a.y] = photoPos(a, t, e);
        ctx.globalAlpha = (0.2 + 0.7 * a.t) * (released ? a.a * fade : 1);
        ctx.beginPath(); ctx.arc(a.x, a.y, airR * (0.6 + 0.9 * a.t), 0, 6.283); ctx.fill();
      }

      // 專案微塵：成像時縮成網點融進照片；散開後回到自己的重量，各自漂浮，出界從另一邊回來
      ctx.fillStyle = ink;
      for (const d of keys) {
        let want: number, alpha: number;
        if (released) {
          // 先在 2.4 秒內散到空中各自的位置，之後才隨空氣漂
          const go = reduce ? 1 : Math.min(1, Math.max(0, (t - relT - d.delay) / 2.4));
          if (go < 1) {
            const g = go * go * (3 - 2 * go);
            d.x = d.sx + (d.su * W - d.sx) * g; d.y = d.sy + (d.sv * H - d.sy) * g;
          } else if (!reduce) {
            const [vx, vy] = flow(d.x, d.y, t, d.z, d.p * 100);
            d.x += vx * dt; d.y += vy * dt;
            if (d.y < -6) { d.y = H + 6; d.x = rnd(d.x + t) * W; }
            if (d.y > H + 8) d.y = -4;
            if (d.x < -6) d.x = W + 4; else if (d.x > W + 6) d.x = -4;
          }
          want = rAir(d);
          alpha = (0.12 + 0.28 * d.z + 0.5 * d.w) * 0.85 + (d.s ? 0.15 : 0);
        } else {
          [d.x, d.y] = photoPos(d, t, e);
          want = rPhoto(d.w);
          alpha = (d.s ? 0.95 : 0.55 + 0.3 * d.w) * (0.3 + 0.7 * e);
        }
        d.rr = d.rr === 0 || reduce ? want : d.rr + (want - d.rr) * 0.04;
        const boost = released ? lightBoost(d.x, d.y, t) : 0;
        ctx.globalAlpha = Math.min(1, alpha + boost * 0.55);
        ctx.beginPath(); ctx.arc(d.x, d.y, d.rr + boost * 0.8, 0, 6.283); ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (hover) {
        ctx.strokeStyle = ink; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(hover.x, hover.y, hover.rr + 5, 0, 6.283); ctx.stroke();
      }
      if (hover && !tip.hidden) positionTip(hover.x, hover.y);
    };

    // 第一次進畫面才開始成像，避免在畫面外就播完；離開畫面時停止繪製
    let raf = 0, visible = false, started = false;
    const loop = (now: number) => { draw(now); raf = visible && !reduce ? requestAnimationFrame(loop) : 0; };
    if (reduce) { started = true; settle(); draw(performance.now()); }
    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      if (!visible || reduce) return;
      if (!started) { started = true; start(); }
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(loop); }
    }).observe(cv);

    root.querySelector('.dots-replay')?.addEventListener('click', () => {
      if (reduce) return;
      start();
      if (!raf) raf = requestAnimationFrame(loop);
    });

    const positionTip = (x: number, y: number) => {
      tip.style.left = `${Math.max(4, Math.min(x + 12, W - tip.offsetWidth - 4))}px`;
      tip.style.top = `${Math.max(y - 36, 4)}px`;
    };
    const pick = (ev: PointerEvent | MouseEvent) => {
      const r = cv.getBoundingClientRect();
      const mx = ev.clientX - r.left, my = ev.clientY - r.top;
      let best: (typeof keys)[number] | null = null, bd = 14 * 14;
      for (const d of keys) {
        const dx = d.x - mx, dy = d.y - my, dd = dx * dx + dy * dy;
        if (dd < bd) { bd = dd; best = d; }
      }
      return best;
    };
    cv.addEventListener('pointermove', (ev) => {
      const best = pick(ev);
      hover = best;
      cv.style.cursor = best?.s ? 'pointer' : 'default';
      if (!best) { tip.hidden = true; if (reduce) draw(performance.now()); return; }
      const w = best.s ? data.works[best.s] : null;
      tip.textContent = w ? `${w.t}　${best.y ?? ''}` : best.y ? `${best.y}` : '—';
      tip.hidden = false;
      positionTip(best.x, best.y);
      if (reduce) draw(performance.now());
    });
    cv.addEventListener('pointerleave', () => { hover = null; tip.hidden = true; if (reduce) draw(performance.now()); });
    cv.addEventListener('click', (ev) => {
      const best = pick(ev);
      if (best?.s) location.href = data.works[best.s].h;
    });
  }

  document.querySelectorAll<HTMLElement>('.dots').forEach(init);
</script>
