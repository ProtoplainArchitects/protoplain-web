---
// 照片：依 group 分組排列（例如施工過程、完工、情境模擬）；情境模擬一律標示，不當作實景照片。點開進 Lightbox。
import { Image, getImage } from 'astro:assets';
import type { Build } from '../data/builds';

interface Props { build: Build; title: string }
const { build, title } = Astro.props;
const items = await Promise.all(
  build.gallery.map(async (g) => ({ ...g, full: (await getImage({ src: g.src, width: 1800, format: 'webp' })).src })),
);
const groups = [...new Set(items.map((g) => g.group))].map((name) => {
  const list = items.filter((g) => g.group === name);
  return { name, list, layout: build.layouts?.[name] ?? 'grid', wide: list.every((g) => g.src.width / g.src.height > 1.6) };
});
const hasRender = items.some((g) => g.kind === 'render');

// editorial：依序套用這組節奏（整欄、一小一大、偏右附說明、整欄），超過五張從頭循環。不裁切，保留原比例
const rhythm = ['full', 'pair-s', 'pair-l', 'aside', 'full'] as const;
const edSizes = { full: '960px', 'pair-s': '400px', 'pair-l': '560px', aside: '640px' };
// sequence：一張一列依時間往下，左側為步驟序號與說明；直式照片收窄，不裁切
// 不放大超過原圖寬度
const edWidths = (w: number) => [480, 800, 1200, 1600].filter((x) => x < w).concat(w);
---
<section class="build build-gallery" aria-labelledby="gallery-title">
  <div class="build-head">
    <h2 id="gallery-title">照片</h2>
    <span class="pp-data build-kicker">PHOTOS · {items.length}</span>
  </div>

  {groups.map((grp) => (
    <>
      <h3 class="pg-sub">{grp.name}</h3>
      {grp.layout === 'sequence' ? (
        <ol class="pg-seq">
          {grp.list.map((p, i) => {
            const tall = p.src.height > p.src.width;
            const label = p.kind === 'render' ? `情境模擬：${p.caption}` : p.caption;
            return (
              <li class:list={[tall && 'pg-tall']}>
                <p class="pg-step"><span class="pp-data pg-no">{String(i + 1).padStart(2, '0')}</span>{p.caption}</p>
                <a href={p.full} data-lb="gallery" data-caption={label}>
                  <Image src={p.src} alt={`${title}：${label}`} widths={edWidths(p.src.width)} sizes={tall ? '(max-width: 760px) 75vw, 420px' : '(max-width: 760px) 100vw, 700px'} format="webp" loading="lazy" />
                </a>
              </li>
            );
          })}
        </ol>
      ) : grp.layout === 'editorial' ? (
        <ul class="pg-ed">
          {grp.list.map((p, i) => {
            const slot = rhythm[i % rhythm.length];
            const label = p.kind === 'render' ? `情境模擬：${p.caption}` : p.caption;
            return (
              <li class={`pg-${slot}`}>
                <a href={p.full} data-lb="gallery" data-caption={label}>
                  <Image src={p.src} alt={`${title}：${label}`} widths={edWidths(p.src.width)} sizes={`(max-width: 760px) 100vw, ${edSizes[slot]}`} format="webp" loading="lazy" />
                </a>
                <p class="pg-cap">{p.caption}</p>
              </li>
            );
          })}
        </ul>
      ) : (
      <ul class:list={['pg-grid', grp.wide && 'pg-wide']}>
        {grp.list.map((p) => {
          const label = p.kind === 'render' ? `情境模擬：${p.caption}` : p.caption;
          return (
            <li>
              <a href={p.full} data-lb="gallery" data-caption={label}>
                <Image src={p.src} alt={`${title}：${label}`} widths={[400, 640]} sizes="(max-width: 760px) 50vw, 310px" format="webp" loading="lazy" />
              </a>
              <p class="pg-cap">{p.caption}</p>
            </li>
          );
        })}
      </ul>
      )}
    </>
  ))}

  {hasRender && <p class="build-note">情境模擬圖以模型為基礎合成，人物與場景不是實景照片，也不代表完工後的實際使用情形。</p>}
  {build.credit && <p class="build-note">{build.credit}</p>}
</section>

<style>
  .pg-sub { font-size: var(--pp-fs-caption); font-weight: var(--pp-fw-medium); color: var(--pp-ink-sub); margin: var(--pp-space-md) 0 var(--pp-space-xs); }
  .pg-sub:first-of-type { margin-top: 0; }
  .pg-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--pp-space-sm); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pg-grid a { display: block; overflow: hidden; border-radius: var(--pp-radius-control); background: var(--pp-bg-card-sub); aspect-ratio: 4 / 3; }
  .pg-wide a { aspect-ratio: 16 / 9; }
  .pg-grid img {
    width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.2s;
    /* 直式照片裁成 4:3 時往上取，人與手上的構件比較不會被切掉 */
    object-position: 50% 25%;
  }
  .pg-grid a:hover img { opacity: 0.88; }
  .pg-cap { font-size: var(--pp-fs-caption); color: var(--pp-ink-sub); margin: 4px 0 0; }

  /* editorial：12 欄，列距放大留出呼吸；圖片保留原比例 */
  .pg-ed {
    list-style: none; margin: 0 0 var(--pp-space-xl); padding: 0;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--pp-space-xl) var(--pp-space-md);
  }
  .pg-ed a { display: block; overflow: hidden; border-radius: var(--pp-radius-control); background: var(--pp-bg-card-sub); }
  .pg-ed img { width: 100%; height: auto; display: block; transition: opacity 0.2s; }
  .pg-ed a:hover img { opacity: 0.88; }
  .pg-full { grid-column: 1 / -1; }
  /* 一小一大並排，小的往下沉，兩張底緣不齊 */
  .pg-pair-s { grid-column: 1 / span 5; align-self: end; }
  .pg-pair-l { grid-column: 6 / -1; }
  /* 偏右的一張，說明放在左側留白的底部 */
  .pg-aside { grid-column: 1 / -1; display: grid; grid-template-columns: 4fr 8fr; gap: var(--pp-space-md); }
  .pg-aside a { grid-column: 2; grid-row: 1; }
  .pg-aside .pg-cap { grid-column: 1; grid-row: 1; align-self: end; text-align: right; margin: 0; }

  /* sequence：每一步一列，細線分隔；左 3 欄步驟、右 9 欄照片 */
  .pg-seq { list-style: none; margin: 0 0 var(--pp-space-xl); padding: 0; }
  .pg-seq li {
    display: grid; grid-template-columns: 3fr 9fr; gap: var(--pp-space-md);
    padding: var(--pp-space-lg) 0; border-top: var(--pp-border-width) solid var(--pp-line);
  }
  .pg-seq li:first-child { padding-top: var(--pp-space-xs); border-top: 0; }
  .pg-step { margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .pg-no { font-size: var(--pp-fs-caption); color: var(--pp-ink-hint); }
  .pg-seq a { display: block; overflow: hidden; border-radius: var(--pp-radius-control); background: var(--pp-bg-card-sub); }
  .pg-tall a { max-width: 420px; }
  .pg-seq img { width: 100%; height: auto; display: block; transition: opacity 0.2s; }
  .pg-seq a:hover img { opacity: 0.88; }

  @media (max-width: 760px) {
    .pg-seq li { display: block; padding: var(--pp-space-md) 0; }
    .pg-step { flex-direction: row; gap: var(--pp-space-xs); margin-bottom: var(--pp-space-xs); }
    .pg-tall a { max-width: none; width: 75%; }
    .pg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pg-wide { grid-template-columns: 1fr; }
    /* 手機單欄；小圖與偏右圖縮窄並左右錯開，留一點節奏 */
    .pg-ed { grid-template-columns: 1fr; row-gap: var(--pp-space-lg); }
    .pg-ed li { grid-column: 1; }
    .pg-pair-s { width: 82%; margin-left: auto; }
    .pg-aside { display: block; width: 82%; }
    .pg-aside .pg-cap { text-align: left; margin-top: 4px; }
  }
</style>
